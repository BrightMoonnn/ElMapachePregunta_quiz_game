<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9BAEF"
    tools:context="UI.JuegoActivityFacil">

    <Button
        android:id="@+id/botonMenu"
        android:layout_width="123dp"
        android:layout_height="61dp"
        android:backgroundTint="#03A9F4"
        android:fontFamily="@font/comic_neue_bold"
        android:text="VOLVER AL MENU"
        android:textColor="#020202"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.102"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.96" />

    <TextView
        android:id="@+id/textPregunta"
        android:layout_width="345dp"
        android:layout_height="177dp"
        android:fontFamily="@font/comic_neue_bold"
        android:textColor="#020202"
        android:textSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.071" />

    <RadioGroup
        android:id="@+id/radioGroupFacil"
        android:layout_width="272dp"
        android:layout_height="288dp"
        android:backgroundTint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.139"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.532">

        <RadioButton
            android:id="@+id/radioRespuesta1F"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:button="@android:drawable/btn_star"
            android:buttonTintMode="add"
            android:fontFamily="@font/comic_neue_bold"
            android:soundEffectsEnabled="true"
            android:textColor="#020202"
            android:textSize="28dp" />

        <RadioButton
            android:id="@+id/radioRespuesta2F"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:button="@android:drawable/btn_star"
            android:buttonTintMode="add"
            android:fontFamily="@font/comic_neue_bold"
            android:textColor="#020202"
            android:textSize="28dp" />

        <RadioButton
            android:id="@+id/radioRespuesta3F"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:button="@android:drawable/btn_star"
            android:buttonTintMode="add"
            android:fontFamily="@font/comic_neue_bold"
            android:textColor="#020202"
            android:textSize="28dp" />

    </RadioGroup>

    <Button
        android:id="@+id/buttonResponder"
        android:layout_width="179dp"
        android:layout_height="68dp"
        android:backgroundTint="#03A9F4"
        android:fontFamily="@font/comic_neue_bold"
        android:text="RESPONDER"
        android:textColor="#020202"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.829" />

    <ImageView
        android:id="@+id/imageViewMapacheInterrogacion"
        android:layout_width="84dp"
        android:layout_height="129dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.518"
        app:srcCompat="@drawable/mapacheinterrogaciont" />

</androidx.constraintlayout.widget.ConstraintLayout>